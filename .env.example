# ======================================================================
# StudyMate production configuration template.
#   cp .env.example .env   then edit EVERY value marked CHANGE.
# .env holds secrets: it is git-ignored. Never commit it. chmod 600 .env
# ======================================================================

# --- Public site -------------------------------------------------------
# Your domain (no https://). Used by Nginx and Let's Encrypt.
DOMAIN=studymate.example.com                       # CHANGE
# Full public origin the browser uses. MUST be https in production.
PUBLIC_ORIGIN=https://studymate.example.com        # CHANGE
# Email Let's Encrypt uses for expiry warnings.
LETSENCRYPT_EMAIL=you@example.com                  # CHANGE

# --- Application -------------------------------------------------------
NODE_ENV=production
PORT=3000
# Nginx is 1 proxy in front of the app (needed for correct client IPs / rate limits).
TRUST_PROXY=1
LOG_LEVEL=info
# Random string, 32+ chars. Generate:  openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48   # CHANGE
SESSION_TTL_HOURS=168
DB_POOL_MAX=10

# --- Database (PostgreSQL runs privately inside Docker) ----------------
POSTGRES_USER=studymate
POSTGRES_DB=studymate
# Random password. Generate:  openssl rand -hex 24      (hex avoids URL-escaping problems)
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_24   # CHANGE
# Compose builds DATABASE_URL for the app from the three values above.

# --- Who runs this site (REQUIRED for a public deployment) --------------
# Shown on the Privacy Policy and Terms pages. Use the real person/organisation responsible for users' data.
# In Ghana, anyone who processes other people's personal data must register as a data controller with the
# Data Protection Commission first (see docs/COMPLIANCE.md). Do not invent details.
# CHANGE: your name or organisation
OPERATOR_NAME=
# CHANGE: postal address
OPERATOR_ADDRESS=
# CHANGE: where people send privacy and deletion requests
OPERATOR_EMAIL=
# Country whose law governs the Terms (confirm with a lawyer)
OPERATOR_JURISDICTION=Ghana
# Outside providers that handle user data for you, e.g. "Acme Hosting (servers), Mailco (email)". Leave empty if none.
OPERATOR_PROCESSORS=
# --- Email (optional, needed for emailed password-reset links) ---------
# Example: smtps://user:pass@smtp.example.com:465   (leave empty to disable)
SMTP_URL=
MAIL_FROM=StudyMate <no-reply@studymate.example.com>
# Without SMTP, administrators generate reset links:  docker compose run --rm app node server/scripts/reset-link.js user@example.com

# --- Nginx mode --------------------------------------------------------
# http  = port 80 only (first start, local testing, certificate issuance)
# https = TLS (after a certificate exists). deploy/scripts/init-letsencrypt.sh switches this for you.
NGINX_TEMPLATES_DIR=./deploy/nginx/templates-http

# --- Backups -----------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
# File containing the backup encryption passphrase (create it, chmod 600, and ALSO store a copy off-server!)
BACKUP_PASSPHRASE_FILE=./secrets/backup_passphrase
# Optional off-server copy via rsync over SSH, e.g. backupuser@backup-host:/srv/studymate-backups/
BACKUP_REMOTE=
