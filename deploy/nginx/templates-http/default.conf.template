# HTTP-only mode: first start, local testing, and Let's Encrypt certificate issuance.
# Do NOT run a public site in this mode for long: credentials would travel unencrypted.
limit_req_zone $binary_remote_addr zone=api:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=auth:10m rate=5r/s;

server {
  listen 80;
  server_name ${DOMAIN} localhost;
  server_tokens off;
  client_max_body_size 400k;

  location /.well-known/acme-challenge/ { root /var/www/certbot; }

  location /api/v1/auth/ {
    limit_req zone=auth burst=10 nodelay;
    proxy_pass http://app:3000;
    include /etc/nginx/proxy_params_studymate;
  }
  location /api/ {
    limit_req zone=api burst=40 nodelay;
    proxy_pass http://app:3000;
    include /etc/nginx/proxy_params_studymate;
  }
  location / {
    proxy_pass http://app:3000;
    include /etc/nginx/proxy_params_studymate;
  }
}
